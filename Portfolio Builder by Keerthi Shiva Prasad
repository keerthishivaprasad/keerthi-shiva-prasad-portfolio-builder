import React, { useState, useEffect, useCallback } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc, onSnapshot, collection } from 'firebase/firestore';

// Ensure Firebase config and app ID are available from the environment
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-portfolio-builder-app';
const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

// Initialize Firebase App
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);

// Default portfolio structure
const defaultPortfolio = {
  name: 'Your Name',
  about: 'A passionate individual interested in web development and technology.',
  skills: ['React', 'JavaScript', 'Tailwind CSS'],
  projects: [
    {
      title: 'My First Project',
      description: 'A brief description of my first project.',
      technologies: ['HTML', 'CSS', 'JS'],
      link: '#'
    }
  ],
  contactEmail: 'your.email@example.com',
  linkedin: '#',
  github: '#'
};

// Main App Component
const App = () => {
  const [userId, setUserId] = useState(null);
  const [portfolio, setPortfolio] = useState(defaultPortfolio);
  const [loading, setLoading] = useState(true);
  const [activeView, setActiveView] = useState('editor'); // 'editor' or 'preview'
  const [showSaveMessage, setShowSaveMessage] = useState(false);
  const [isViewerMode, setIsViewerMode] = useState(false); // New state for viewer mode
  const [shareableUrl, setShareableUrl] = useState('');
  const [showShareMessage, setShowShareMessage] = useState(false);
  const [copiedMessage, setCopiedMessage] = useState(false); // New state for copy message

  // Authenticate user and set up Firestore listener
  useEffect(() => {
    const setupFirebaseAndFetchData = async () => {
      // Check for viewId in URL to determine viewer mode
      const urlParams = new URLSearchParams(window.location.search);
      const viewId = urlParams.get('viewId');

      if (viewId) {
        setIsViewerMode(true);
        // Fetch public portfolio
        const publicPortfolioDocRef = doc(db, `artifacts/${appId}/public/data/publishedPortfolios/${viewId}`);
        const unsubscribePublic = onSnapshot(publicPortfolioDocRef, (docSnap) => {
          if (docSnap.exists()) {
            const data = docSnap.data();
            const parsedSkills = data.skills ? JSON.parse(data.skills) : [];
            const parsedProjects = data.projects ? JSON.parse(data.projects) : [];
            setPortfolio({
              ...defaultPortfolio,
              ...data,
              skills: parsedSkills,
              projects: parsedProjects
            });
            setActiveView('preview'); // Force preview mode in viewer mode
          } else {
            console.warn("Public portfolio not found for ID:", viewId);
            setPortfolio(defaultPortfolio); // Show default if not found
          }
          setLoading(false);
        }, (error) => {
          console.error("Error fetching public portfolio:", error);
          setLoading(false);
        });
        return () => unsubscribePublic();
      } else {
        // Normal builder mode - authenticate and fetch private portfolio
        try {
          if (initialAuthToken) {
            await signInWithCustomToken(auth, initialAuthToken);
          } else {
            await signInAnonymously(auth);
          }
        } catch (error) {
          console.error("Firebase authentication error:", error);
        }

        const unsubscribeAuth = onAuthStateChanged(auth, (user) => {
          if (user) {
            setUserId(user.uid);
            const userPortfolioDocRef = doc(db, `artifacts/${appId}/users/${user.uid}/portfolios/myPortfolio`);
            const unsubscribePrivate = onSnapshot(userPortfolioDocRef, (docSnap) => {
              if (docSnap.exists()) {
                const data = docSnap.data();
                const parsedSkills = data.skills ? JSON.parse(data.skills) : [];
                const parsedProjects = data.projects ? JSON.parse(data.projects) : [];
                setPortfolio({
                  ...defaultPortfolio,
                  ...data,
                  skills: parsedSkills,
                  projects: parsedProjects
                });
              } else {
                setPortfolio(defaultPortfolio);
                setDoc(userPortfolioDocRef, {
                  ...defaultPortfolio,
                  skills: JSON.stringify(defaultPortfolio.skills),
                  projects: JSON.stringify(defaultPortfolio.projects)
                }).catch(e => console.error("Error setting default portfolio:", e));
              }
              setLoading(false);
            }, (error) => {
              console.error("Error fetching private portfolio:", error);
              setLoading(false);
            });
            return () => unsubscribePrivate();
          } else {
            setUserId(null);
            setLoading(false);
          }
        });
        return () => unsubscribeAuth();
      }
    };

    setupFirebaseAndFetchData();
  }, []); // Run only once on component mount

  // Function to save portfolio data to Firestore (private)
  const savePortfolio = useCallback(async (updatedPortfolio) => {
    if (!userId || isViewerMode) {
      console.warn("User not authenticated or in viewer mode, cannot save private portfolio.");
      return;
    }
    const userPortfolioDocRef = doc(db, `artifacts/${appId}/users/${userId}/portfolios/myPortfolio`);
    try {
      const dataToSave = {
        ...updatedPortfolio,
        skills: JSON.stringify(updatedPortfolio.skills),
        projects: JSON.stringify(updatedPortfolio.projects)
      };
      await setDoc(userPortfolioDocRef, dataToSave);
      setShowSaveMessage(true);
      setTimeout(() => setShowSaveMessage(false), 2000);
    } catch (e) {
      console.error("Error saving private document: ", e);
    }
  }, [userId, isViewerMode]);

  // Function to publish portfolio data to Firestore (public)
  const publishPortfolio = useCallback(async () => {
    if (!userId || isViewerMode) {
      console.warn("User not authenticated or in viewer mode, cannot publish portfolio.");
      return;
    }
    const publicPortfolioDocRef = doc(db, `artifacts/${appId}/public/data/publishedPortfolios/${userId}`);
    try {
      const dataToSave = {
        ...portfolio,
        skills: JSON.stringify(portfolio.skills),
        projects: JSON.stringify(portfolio.projects)
      };
      await setDoc(publicPortfolioDocRef, dataToSave);
      const currentUrl = window.location.origin + window.location.pathname;
      const newShareableUrl = `${currentUrl}?viewId=${userId}`;
      setShareableUrl(newShareableUrl);
      setShowShareMessage(true);
      setTimeout(() => setShowShareMessage(false), 5000); // Show for 5 seconds
    } catch (e) {
      console.error("Error publishing portfolio: ", e);
      // Using a custom message instead of alert
      setShowShareMessage(true); // Keep message visible for error
      setShareableUrl("Error publishing portfolio. Please try again.");
    }
  }, [userId, portfolio, isViewerMode]);

  // Handle changes in the portfolio form
  const handleChange = (e) => {
    const { name, value } = e.target;
    let updatedPortfolio = { ...portfolio, [name]: value };

    if (name === 'skillsInput') {
      updatedPortfolio = { ...updatedPortfolio, skills: value.split(',').map(s => s.trim()).filter(s => s !== '') };
    }

    setPortfolio(updatedPortfolio);
    savePortfolio(updatedPortfolio);
  };

  // Handle project changes
  const handleProjectChange = (index, field, value) => {
    const updatedProjects = portfolio.projects.map((project, i) =>
      i === index ? { ...project, [field]: value } : project
    );
    const updatedPortfolio = { ...portfolio, projects: updatedProjects };
    setPortfolio(updatedPortfolio);
    savePortfolio(updatedPortfolio);
  };

  // Add a new project
  const addProject = () => {
    const updatedProjects = [
      ...portfolio.projects,
      { title: '', description: '', technologies: [], link: '' }
    ];
    const updatedPortfolio = { ...portfolio, projects: updatedProjects };
    setPortfolio(updatedPortfolio);
    savePortfolio(updatedPortfolio);
  };

  // Remove a project
  const removeProject = (index) => {
    const updatedProjects = portfolio.projects.filter((_, i) => i !== index);
    const updatedPortfolio = { ...portfolio, projects: updatedProjects };
    setPortfolio(updatedPortfolio);
    savePortfolio(updatedPortfolio);
  };

  const copyToClipboard = () => {
    const urlInput = document.querySelector('.shareable-url-input');
    if (urlInput) {
      urlInput.select();
      document.execCommand('copy'); // Deprecated but works in iframes
      setCopiedMessage(true);
      setTimeout(() => setCopiedMessage(false), 1500); // Hide "Copied!" after 1.5 seconds
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-900 text-white"
           style={{
             backgroundColor: '#1a202c', // A dark gray/almost black
             backgroundImage: 'radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.05) 1px, transparent 1px), radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.05) 1px, transparent 1px)',
             backgroundSize: '40px 40px'
           }}>
        <div className="text-indigo-300 text-xl font-semibold">Loading your portfolio...</div>
      </div>
    );
  }

  return (
    <div className="min-h-screen font-inter text-gray-200 flex flex-col"
         style={{
           backgroundColor: '#1a202c', // A dark gray/almost black
           backgroundImage: 'radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.05) 1px, transparent 1px), radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.05) 1px, transparent 1px)',
           backgroundSize: '40px 40px'
         }}>
      {/* Add CSS for fade-in-out animation */}
      <style>
        {`
        @keyframes fade-in-out {
          0% { opacity: 0; transform: translateY(10px); }
          20% { opacity: 1; transform: translateY(0); }
          80% { opacity: 1; transform: translateY(0); }
          100% { opacity: 0; transform: translateY(-10px); }
        }
        .animate-fade-in-out {
          animation: fade-in-out 1.5s forwards;
        }
        `}
      </style>
      {/* Header */}
      <header className="bg-indigo-700 text-white p-4 shadow-md">
        <div className="container mx-auto flex flex-col md:flex-row justify-between items-center">
          <h1 className="text-3xl font-bold mb-2 md:mb-0">Portfolio Builder by Keerthi Shiva Prasad</h1>
          {!isViewerMode && (
            <div className="flex space-x-4">
              <button
                onClick={() => setActiveView('editor')}
                className={`px-4 py-2 rounded-lg transition-colors duration-300
                  ${activeView === 'editor' ? 'bg-indigo-500' : 'bg-indigo-600 hover:bg-indigo-500'}
                `}
              >
                Editor
              </button>
              <button
                onClick={() => setActiveView('preview')}
                className={`px-4 py-2 rounded-lg transition-colors duration-300
                  ${activeView === 'preview' ? 'bg-indigo-500' : 'bg-indigo-600 hover:bg-indigo-500'}
                `}
              >
                Preview
              </button>
            </div>
          )}
        </div>
      </header>

      {/* Main Content Area */}
      <main className="flex-grow container mx-auto p-4 md:p-8">
        {showSaveMessage && (
          <div className="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong className="font-bold">Saved!</strong>
            <span className="block sm:inline ml-2">Your changes have been saved automatically.</span>
          </div>
        )}

        {showShareMessage && (
          <div className="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong className="font-bold">Portfolio Published!</strong>
            <span className="block sm:inline ml-2">Here's your public web link: </span>
            <div className="flex items-center mt-2">
              <input
                type="text"
                readOnly
                value={shareableUrl}
                className="shareable-url-input flex-grow p-2 border rounded-md bg-blue-50 text-blue-800 break-all mr-2"
                onClick={(e) => e.target.select()} // Select text on click
              />
              <button
                onClick={copyToClipboard}
                className="bg-blue-600 text-white px-3 py-1 rounded-md hover:bg-blue-700 transition-colors duration-300 relative"
              >
                Copy Link
                {copiedMessage && (
                  <span className="absolute -top-6 left-1/2 -translate-x-1/2 bg-gray-700 text-white text-xs px-2 py-1 rounded animate-fade-in-out">
                    Copied!
                  </span>
                )}
              </button>
            </div>
          </div>
        )}

        {userId && !isViewerMode && (
          <div className="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded relative mb-4 text-sm">
            <strong className="font-bold">Your User ID:</strong> <span className="break-all">{userId}</span>
            <span className="block sm:inline ml-2"> (This ID identifies your editable portfolio. Use the 'Publish' button to get a shareable link.)</span>
          </div>
        )}

        {isViewerMode ? (
          <PortfolioPreview portfolio={portfolio} />
        ) : (
          activeView === 'editor' ? (
            <PortfolioEditor
              portfolio={portfolio}
              handleChange={handleChange}
              handleProjectChange={handleProjectChange}
              addProject={addProject}
              removeProject={removeProject}
              publishPortfolio={publishPortfolio} // Pass publish function
            />
          ) : (
            <PortfolioPreview portfolio={portfolio} />
          )
        )}
      </main>

      {/* Footer */}
      <footer className="bg-gray-800 text-white p-4 text-center mt-8">
        <div className="container mx-auto">
          <p>&copy; {new Date().getFullYear()} Portfolio Builder by Keerthi Shiva Prasad. All rights reserved.</p>
        </div>
      </footer>
    </div>
  );
};

